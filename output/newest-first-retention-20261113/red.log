            window = db.execute('SELECT window_id FROM windows WHERE bucket=?', (bucket,)).fetchone()[0]
            sample = dict(self.identity, sample_id=str(uuid4()), capture_seq=seq, window_id=window,
                          sampled_at_us=sampled_ns // 1000, time_quality='trusted',
