# Copy to .env and adjust for your local environment.
# .env is gitignored — keep secrets there only.
#
# device-service NON-secret tunables (LLM/budget/discovery/mqtt) live in the annotated
# file config/device-service.toml (edit there). .env / env vars OVERRIDE that file and
# hold SECRETS ONLY: DB_AI_PASSWORD, DB_OPS_PASSWORD, OPS/INGEST/AI_API_KEY, LLM_API_KEY.

# --- Database ---
POSTGRES_PASSWORD=postgres
AUTHENTICATOR_PASSWORD=changeme

# --- device-service DB roles (PRD-0003, ADR-017) ---
# Per-role login passwords for the two connection pools (device_service_ai / device_service_ops).
# After migration 010 creates the roles, set passwords with:
#   set -a; source .env; set +a; bash infra/timescaledb/set_role_passwords.sh
# Rotate for production (Promotion Checklist P-7).
DB_AI_PASSWORD=changeme_ai
DB_OPS_PASSWORD=changeme_ops

# --- device-service X-API-Key channels (PRD-0003, FR-310) ---
OPS_API_KEY=changeme_ops_key
INGEST_API_KEY=changeme_ingest_key
AI_API_KEY=changeme_ai_key

# --- EMS BFF auth (PRD-0005 §9 / ADR-024) ---
# Provider: "local" (argon2id fallback, default) or "oidc" (enterprise IdP, Authorization-Code+PKCE — ADR-024).
BFF_AUTH_MODE=local
# Local user table — env/.env ONLY, never the committed TOML. Records are ';'-separated:
#   username:<argon2id PHC string>:role     (role = ops|ingest|readonly)
# Generate a record:  docker run --rm -i ems-bff-test python -m bff.hashpw --user ops_user --role ops
# (PHC embeds salt + cost params; the comma in m=..,t=..,p=.. is why records use ';'.)
BFF_AUTH_USERS=
# The BFF reuses OPS_API_KEY / INGEST_API_KEY above as its upstream channel keys; the AI key is NOT given to the BFF.
# OIDC (enterprise IdP) — only used when BFF_AUTH_MODE=oidc (ADR-024). Discovery = {issuer}/.well-known/openid-configuration.
BFF_OIDC_ISSUER=
BFF_OIDC_CLIENT_ID=
BFF_OIDC_CLIENT_SECRET=
BFF_OIDC_REDIRECT_URI=
BFF_OIDC_SCOPES=openid profile email
# id-token claim carrying role/group values (single or list); first mapped value wins:
BFF_OIDC_ROLE_CLAIM=groups
# csv claimval:role (role = ops|ingest|readonly); unmapped/empty -> rejected (no default privilege):
BFF_OIDC_ROLE_MAP=

# --- device-service audit salt (PRD-0003 §7.3a / FR-345) ---
# HMAC salt for created_by_key_id on human corrections; the raw OPS key is never stored.
# Required before any /ai-feedback write. Rotate every 90d (bump AUDIT_SALT_VERSION in
# config/device-service.toml on rotation). AUDIT_SALT_VERSION is non-secret (lives in TOML).
AUDIT_HASH_SALT=changeme_audit_salt_min_32_chars_random

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- Telegram (Grafana Alerting contact point) ---
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=7171144544
